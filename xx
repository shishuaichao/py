





# 3. 测试聊天（单轮/多轮）
if __name__ == "__main__":
    # 对话上下文（保存历史消息，实现多轮聊天）
    chat_history = []
    
    print("豆包聊天助手（输入 '退出' 结束对话）")
    while True:
        # 获取用户输入
        user_input = input("你：")
        if user_input.strip() == "退出":
            print("豆包：再见！")
            break
        
        # 添加用户消息到上下文
        chat_history.append({"role": "user", "content": user_input})
        
        # 调用 API 获取回复
        reply = chat_with_douban(chat_history)
        print(f"豆包：{reply}")
        
        # 添加豆包回复到上下文（实现多轮对话）
        chat_history.append({"role": "assistant", "content": reply})